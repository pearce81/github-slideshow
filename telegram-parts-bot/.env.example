# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
# Timezone used for "today" and "this month" (e.g. Asia/Tehran, Europe/Istanbul, UTC)
TIMEZONE=UTC
# SQLite file where messages are stored
DB_PATH=parts.db
# Optional: comma-separated Telegram user ids allowed to run reports (empty = everyone)
ADMIN_IDS=
# Optional: only record these groups (empty = every group the bot is in)
TRACKED_CHAT_IDS=
# Optional: group to report on when you message the bot privately
GROUP_ID=
